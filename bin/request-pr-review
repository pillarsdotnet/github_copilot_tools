#!/bin/bash
#
# Coordinate the two-part Chrome debugging workflow for requesting Copilot reviews.
#
# This script handles the complete STEP 12 workflow:
# 1. Launch Chrome in debugging mode (WSL-side via launch-chrome-debugger)
# 2. Wait for user GitHub confirmation
# 3. Execute the Windows-side tool to automate the PR review button click
#
# IMPORTANT: The Windows-side tool (request-copilot-review-windows.exe) must be
# executed from a Windows context (PowerShell, Command Prompt, or via wsl.exe invocation).
#
# Exit codes:
#   0 = Review request completed successfully
#   1 = Error (launch failed, user declined, Windows tool failed, etc.)
#
# Usage: request-pr-review [-r REPO] <PR_NUMBER>
# Example: request-pr-review -r owner/repo 116
#          request-pr-review 116  # REPO derived from cwd
#
# -r/REPO is optional: if not given, it's derived from the current
# directory's GitHub remote instead.
#

set -e

REPO=""
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  if [[ "$1" == -* && "$1" != --* ]]; then
    OPTIND=1
    getopts ":r:" OPT
    case "$OPT" in
      r) REPO="$OPTARG" ;;
      :) echo "Error: -r requires an argument" >&2; exit 1 ;;
      \?) echo "Error: unknown option -$OPTARG" >&2; exit 1 ;;
    esac
    shift $((OPTIND - 1))
  else
    POSITIONAL+=("$1")
    shift
  fi
done
set -- "${POSITIONAL[@]}"

if [[ -z "$REPO" ]]; then
  REPO=$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null || true)
  if [[ -z "$REPO" ]]; then
    echo "Error: REPO not given (-r), and cwd is not a GitHub repo (run from inside a repo checkout, or pass -r REPO explicitly)" >&2
    exit 1
  fi
fi
PR_NUM="$1"

if [[ -z "$PR_NUM" ]]; then
  echo "Usage: request-pr-review [-r OWNER/REPO] <PR_NUMBER>" >&2
  echo "Example: request-pr-review -r owner/repo 116" >&2
  exit 1
fi

REPO_OWNER="${REPO%/*}"
REPO_NAME="${REPO#*/}"

echo "════════════════════════════════════════════════════════════════"
echo "  STEP 12: Request New Copilot Review"
echo "════════════════════════════════════════════════════════════════"
echo ""

# Step 1: Launch Chrome in debug mode (WSL-side)
echo "Step 1: Launching Chrome in debugging mode..."
echo ""

if ! launch-chrome-debugger; then
  echo "✗ Failed to launch Chrome debugging session"
  exit 1
fi

echo ""
echo "✓ Chrome debugging session ready"
echo ""

# Step 2: Call the Windows-side tool
# The tool must run from Windows, so we need to invoke it via powershell or cmd
echo "════════════════════════════════════════════════════════════════"
echo "  Step 2: Invoking Windows-side automation..."
echo "════════════════════════════════════════════════════════════════"
echo ""

# Find the Windows tool
WINDOWS_TOOL="$HOME/.copilot-tools/request-copilot-review-windows.exe"

if [ ! -f "$WINDOWS_TOOL" ]; then
  echo "✗ Error: Windows tool not found at $WINDOWS_TOOL"
  echo ""
  echo "Installation:"
  echo "  1. From the github_copilot_tools repository, the Windows tool was built at:"
  echo "     ~/src/github/pillarsdotnet/github_copilot_tools/cmd/request-copilot-review-windows/request-copilot-review-windows.exe"
  echo ""
  echo "  2. Copy it to: $WINDOWS_TOOL"
  echo "     cp ~/src/github/pillarsdotnet/github_copilot_tools/cmd/request-copilot-review-windows/request-copilot-review-windows.exe $WINDOWS_TOOL"
  echo ""
  exit 1
fi

echo "Executing: $WINDOWS_TOOL -pr $PR_NUM -owner $REPO_OWNER -repo $REPO_NAME"
echo ""

# Run the Windows tool
"$WINDOWS_TOOL" -pr "$PR_NUM" -owner "$REPO_OWNER" -repo "$REPO_NAME"
TOOL_EXIT=$?

echo ""

if [ $TOOL_EXIT -eq 0 ]; then
  echo "════════════════════════════════════════════════════════════════"
  echo "  ✓ Review Request Complete"
  echo "════════════════════════════════════════════════════════════════"
  echo ""
  echo "GitHub has queued a new Copilot review for $REPO#$PR_NUM"
  echo ""
  echo "Expected next steps:"
  echo "  1. Wait 1-2 minutes for Copilot to analyze the PR"
  echo "  2. Refresh the GitHub PR page to see the new review"
  echo "  3. Continue with the next PR in the stack if applicable"
  echo ""
  exit 0
else
  echo "✗ Windows tool returned error code: $TOOL_EXIT"
  exit 1
fi
