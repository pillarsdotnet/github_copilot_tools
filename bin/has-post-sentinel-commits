#!/bin/bash
#
# Check if there are code commits subsequent to the latest Copilot review
# that change any files changed by the PR.
#
# Usage: has-post-sentinel-commits [-r REPO] <PR_NUMBER>
# Example: has-post-sentinel-commits -r owner/repo 116
#          has-post-sentinel-commits 116  # REPO derived from cwd
#
# -r/REPO is optional: if not given, it's derived from the current
# directory's GitHub remote instead.
#
# Exit code: 0 if there are post-sentinel commits changing PR files, 1 otherwise
#

set -e

REPO=""
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  if [[ "$1" == -* && "$1" != --* ]]; then
    OPTIND=1
    getopts ":r:" OPT
    case "$OPT" in
      r) REPO="$OPTARG" ;;
      :) echo "Error: -r requires an argument" >&2; exit 1 ;;
      \?) echo "Error: unknown option -$OPTARG" >&2; exit 1 ;;
    esac
    shift $((OPTIND - 1))
  else
    POSITIONAL+=("$1")
    shift
  fi
done
set -- "${POSITIONAL[@]}"

if [[ -z "$REPO" ]]; then
  REPO=$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null || true)
  if [[ -z "$REPO" ]]; then
    echo "Error: REPO not given (-r), and cwd is not a GitHub repo (run from inside a repo checkout, or pass -r REPO explicitly)" >&2
    exit 1
  fi
fi
PR_NUMBER="$1"

if [[ -z "$PR_NUMBER" ]]; then
  echo "Usage: has-post-sentinel-commits [-r REPO] <PR_NUMBER>" >&2
  echo "Example: has-post-sentinel-commits -r owner/repo 116" >&2
  exit 1
fi

IFS='/' read -r OWNER REPO_NAME <<< "$REPO"
if [[ -z "$REPO_NAME" ]]; then
  echo "Error: REPO must be in format 'owner/name'" >&2
  exit 1
fi

PR_DATA=$(gh api graphql -f query="query {
  repository(owner: \"$OWNER\", name: \"$REPO_NAME\") {
    pullRequest(number: $PR_NUMBER) {
      updatedAt
      commits(last: 1) {
        edges {
          node {
            committedDate
          }
        }
      }
      reviews(first: 100) {
        edges {
          node {
            databaseId
            createdAt
            author {
              login
            }
          }
        }
      }
      files(first: 100) {
        edges {
          node {
            path
          }
        }
      }
    }
  }
}" 2>/dev/null)

LATEST_REVIEW_TIME=$(echo "$PR_DATA" | jq -r '.data.repository.pullRequest.reviews.edges[] | select(.node.author.login == "copilot-pull-request-reviewer") | .node.createdAt' | sort -r | head -1)

if [[ -z "$LATEST_REVIEW_TIME" ]]; then
  exit 1
fi

PR_FILES=$(echo "$PR_DATA" | jq -r '.data.repository.pullRequest.files.edges[].node.path')

COMMITS_AFTER=$(gh api graphql -f query="query {
  repository(owner: \"$OWNER\", name: \"$REPO_NAME\") {
    defaultBranchRef {
      target {
        ... on Commit {
          history(first: 100) {
            edges {
              node {
                committedDate
                changedFiles
                files(first: 100) {
                  edges {
                    node {
                      path
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}" 2>/dev/null | jq -r ".data.repository.defaultBranchRef.target.history.edges[] | select(.node.committedDate > \"$LATEST_REVIEW_TIME\") | .node.files.edges[].node.path" | sort -u)

if [[ -z "$COMMITS_AFTER" ]]; then
  exit 1
fi

for file in $PR_FILES; do
  if echo "$COMMITS_AFTER" | grep -q "^$file\$"; then
    exit 0
  fi
done

exit 1
