#!/bin/bash
#
# Check if changes between branches are only from rebasing.
#
# Compares files changed between remote BASE and local HEAD with files changed
# between remote HEAD and local HEAD. Returns the count of files that appear in
# both lists (files that have been both rebased from upstream and locally modified).
#
# Usage: check-changed-files <BASE_BRANCH> <HEAD_BRANCH>
# Example: check-changed-files origin/main feature/my-feature
#
# Exit codes:
#  -1 = Error in arguments or processing
#  0+ = Number of files changed beyond a simple rebase
set -e

# Arguments
BASE_BRANCH="$1"
HEAD_BRANCH="$2"

# Validation
if [[ -z "$BASE_BRANCH" ]] || [[ -z "$HEAD_BRANCH" ]]; then
  echo "Usage: check-changed-files <BASE_BRANCH> <HEAD_BRANCH>" >&2
  echo "Example: check-changed-files origin/main feature/my-feature" >&2
  echo "" >&2
  echo "Returns the number of files changed in both:" >&2
  echo "  - Between remote BASE and local HEAD" >&2
  echo "  - Between remote HEAD and local HEAD" >&2
  exit -1
fi

# Verify branches exist
if ! git rev-parse "$BASE_BRANCH" > /dev/null 2>&1; then
  echo "Error: Branch not found: $BASE_BRANCH" >&2
  exit -1
fi

if ! git rev-parse "$HEAD_BRANCH" > /dev/null 2>&1; then
  echo "Error: Branch not found: $HEAD_BRANCH" >&2
  exit -1
fi

# Get files changed between remote BASE and local HEAD
# These are all files touched by the PR
FILES_IN_PR=$(git diff --name-only "$BASE_BRANCH" "$HEAD_BRANCH" 2>/dev/null | sort)

# Get files changed between remote HEAD and local HEAD
# These are files changed locally beyond what's on the remote
FILES_LOCAL_ONLY=$(git diff --name-only "$HEAD_BRANCH" HEAD 2>/dev/null | sort)

# Count files
PR_COUNT=$(echo "$FILES_IN_PR" | grep -c '^' || true)
LOCAL_COUNT=$(echo "$FILES_LOCAL_ONLY" | grep -c '^' || true)

# Find common files (files that appear in both lists)
# These are files that have been both rebased and locally modified
COMMON_FILES=$(comm -12 <(echo "$FILES_IN_PR" | grep '^' || true) <(echo "$FILES_LOCAL_ONLY" | grep '^' || true) 2>/dev/null || echo "")

# Count common files
COMMON_COUNT=$(echo "$COMMON_FILES" | grep -c '^' || echo 0)

# Output results
echo "════════════════════════════════════════════════════════════════════"
echo "Rebase Analysis: $BASE_BRANCH → $HEAD_BRANCH → HEAD"
echo "════════════════════════════════════════════════════════════════════"
echo ""
echo "Files changed in PR (BASE → HEAD):"
echo "  Total: $PR_COUNT"
if [[ $PR_COUNT -le 10 ]]; then
  if [[ -n "$FILES_IN_PR" ]]; then
    echo "$FILES_IN_PR" | sed 's/^/    /'
  fi
fi
echo ""
echo "Files changed locally (HEAD → current):"
echo "  Total: $LOCAL_COUNT"
if [[ $LOCAL_COUNT -le 10 ]]; then
  if [[ -n "$FILES_LOCAL_ONLY" ]]; then
    echo "$FILES_LOCAL_ONLY" | sed 's/^/    /'
  fi
fi
echo ""
echo "Files changed in BOTH (rebased + locally modified):"
echo "  Total: $COMMON_COUNT"
if [[ $COMMON_COUNT -gt 0 ]] && [[ $COMMON_COUNT -le 10 ]]; then
  if [[ -n "$COMMON_FILES" ]]; then
    echo "$COMMON_FILES" | sed 's/^/    /'
  fi
fi
echo ""
echo "════════════════════════════════════════════════════════════════════"
echo ""

# Analysis
if [[ $LOCAL_COUNT -eq 0 ]]; then
  echo "✓ Pure rebase: No local changes beyond remote HEAD"
  exit 0
elif [[ $COMMON_COUNT -eq 0 ]]; then
  echo "✓ No rebase needed: All changes are new local commits"
  exit 0
else
  echo "⚠ Mixed: Branch has both rebased changes and new local changes"
  echo "  $COMMON_COUNT file(s) were modified and then rebased"
  exit $COMMON_COUNT
fi
