#!/bin/bash
# Hide a GitHub PR review with reason "Resolved"
# Usage: hide-pr-review <PR_NUMBER> <REVIEW_ID>
# Example: hide-pr-review 116 4963098756

set -e

if [ $# -lt 2 ]; then
    echo "Usage: hide-pr-review <PR_NUMBER> <REVIEW_ID>"
    echo "Example: hide-pr-review 116 4963098756"
    exit 1
fi

PR=$1
REVIEW_ID=$2

echo "🔍 Fetching review comment ID for review #$REVIEW_ID on PR #$PR..."

# Get the comment ID of the review (first comment in the review)
COMMENT_ID=$(gh api graphql -f query='
query {
  repository(owner: "owner", name: "repo") {
    pullRequest(number: '$PR') {
      reviews(first: 50) {
        nodes {
          databaseId
          comments(first: 1) {
            nodes {
              id
            }
          }
        }
      }
    }
  }
}
' 2>/dev/null | jq -r ".data.repository.pullRequest.reviews.nodes[] | select(.databaseId == $REVIEW_ID) | .comments.nodes[0].id" | head -1)

if [ -z "$COMMENT_ID" ] || [ "$COMMENT_ID" = "null" ]; then
    echo "❌ Could not find comment ID for review #$REVIEW_ID"
    exit 1
fi

echo "✓ Found comment ID: $COMMENT_ID"
echo ""
echo "🔒 Hiding review with reason 'Resolved'..."

RESULT=$(gh api graphql -f commentId="$COMMENT_ID" -f query='
mutation($commentId: ID!) {
  minimizeComment(input: {subjectId: $commentId, classifier: RESOLVED}) {
    minimizedComment {
      isMinimized
      minimizedReason
    }
  }
}
' 2>/dev/null)

IS_MINIMIZED=$(echo "$RESULT" | jq -r '.data.minimizeComment.minimizedComment.isMinimized')
REASON=$(echo "$RESULT" | jq -r '.data.minimizeComment.minimizedComment.minimizedReason')

if [ "$IS_MINIMIZED" = "true" ]; then
    echo "✅ Successfully hidden review $REVIEW_ID with reason \"$REASON\"!"
    echo ""
    echo "The review now shows:"
    echo "  • isMinimized: true"
    echo "  • minimizedReason: \"$REASON\""
else
    echo "❌ Failed to hide review"
    echo "$RESULT" | jq '.'
    exit 1
fi
