#!/bin/bash
#
# Hide a GitHub PR review with reason "Resolved".
#
# Usage: hide-pr-review [-r REPO] <PR_NUMBER> <REVIEW_ID> [REASON]
# Example: hide-pr-review -r owner/repo 116 4963098756
#          hide-pr-review -r owner/repo 116 4963098756 "Addressed"
#          hide-pr-review 116 4963098756  # REPO derived from cwd
#
# -r/REPO is optional: if not given, it's derived from the current
# directory's GitHub remote instead.
#
# Exit codes:
#   0 = Successfully hidden review
#   1 = Failed to hide review or invalid arguments
#

set -e

# Arguments: -r/REPO is optional (see header comment above).
REPO=""
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  if [[ "$1" == -* && "$1" != --* ]]; then
    OPTIND=1
    getopts ":r:" OPT
    case "$OPT" in
      r) REPO="$OPTARG" ;;
      :) echo "Error: -r requires an argument" >&2; exit 1 ;;
      \?) echo "Error: unknown option -$OPTARG" >&2; exit 1 ;;
    esac
    shift $((OPTIND - 1))
  else
    POSITIONAL+=("$1")
    shift
  fi
done
set -- "${POSITIONAL[@]}"

if [[ -z "$REPO" ]]; then
  REPO=$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null || true)
  if [[ -z "$REPO" ]]; then
    echo "Error: REPO not given (-r), and cwd is not a GitHub repo (run from inside a repo checkout, or pass -r REPO explicitly)" >&2
    exit 1
  fi
fi
PR_NUMBER="$1"
REVIEW_ID="$2"
REASON="${3:-Resolved}"

# Validation
if [[ -z "$PR_NUMBER" ]] || [[ -z "$REVIEW_ID" ]]; then
  echo "Usage: hide-pr-review [-r REPO] <PR_NUMBER> <REVIEW_ID> [REASON]" >&2
  echo "Example: hide-pr-review -r owner/repo 116 4963098756" >&2
  echo "         hide-pr-review -r owner/repo 116 4963098756 \"Addressed\"" >&2
  exit 1
fi

# Parse repo
IFS='/' read -r OWNER REPO_NAME <<< "$REPO"
if [[ -z "$REPO_NAME" ]]; then
  echo "Error: REPO must be in format 'owner/name'" >&2
  exit 1
fi

echo "🔍 Fetching review ID for review #$REVIEW_ID on $REPO PR #$PR_NUMBER..."

# Get the review's global ID (not a comment ID) - we minimize the review itself, not its comments
REVIEW_GLOBAL_ID=$(gh api graphql -f query='
query {
  repository(owner: "'$OWNER'", name: "'$REPO_NAME'") {
    pullRequest(number: '$PR_NUMBER') {
      reviews(first: 100) {
        nodes {
          databaseId
          id
        }
      }
    }
  }
}
' 2>/dev/null | jq -r ".data.repository.pullRequest.reviews.nodes[] | select(.databaseId == $REVIEW_ID) | .id" | head -1)

if [[ -z "$REVIEW_GLOBAL_ID" ]] || [[ "$REVIEW_GLOBAL_ID" == "null" ]]; then
  echo "Error: Could not find review ID for review #$REVIEW_ID" >&2
  exit 1
fi

echo "✓ Found review ID: $REVIEW_GLOBAL_ID"
echo ""
echo "🔒 Hiding review with reason '$REASON'..."

RESULT=$(gh api graphql -f subjectId="$REVIEW_GLOBAL_ID" -f query='
mutation($subjectId: ID!) {
  minimizeComment(input: {subjectId: $subjectId, classifier: RESOLVED}) {
    minimizedComment {
      isMinimized
      minimizedReason
    }
  }
}
' 2>/dev/null)

IS_MINIMIZED=$(echo "$RESULT" | jq -r '.data.minimizeComment.minimizedComment.isMinimized')
MINIMIZED_REASON=$(echo "$RESULT" | jq -r '.data.minimizeComment.minimizedComment.minimizedReason')

if [[ "$IS_MINIMIZED" == "true" ]]; then
  echo "✅ Successfully hidden review $REVIEW_ID with reason \"$MINIMIZED_REASON\"!"
  exit 0
else
  echo "Error: Failed to hide review" >&2
  echo "$RESULT" | jq '.' >&2
  exit 1
fi
