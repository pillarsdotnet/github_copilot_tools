#!/bin/bash
#
# Check if a Copilot review is a sentinel (generated no new comments).
#
# Usage: is-sentinel-review <REPO> <PR_NUMBER> <REVIEW_DATABASE_ID>
# Example: is-sentinel-review owner/repo 116 4964619882
#
# Exit code: 0 if sentinel, 1 if not sentinel or error
#

set -e

REPO="$1"
PR_NUMBER="$2"
REVIEW_ID="$3"

if [[ -z "$REPO" ]] || [[ -z "$PR_NUMBER" ]] || [[ -z "$REVIEW_ID" ]]; then
  echo "Usage: is-sentinel-review <REPO> <PR_NUMBER> <REVIEW_DATABASE_ID>" >&2
  echo "Example: is-sentinel-review owner/repo 116 4964619882" >&2
  exit 1
fi

IFS='/' read -r OWNER REPO_NAME <<< "$REPO"
if [[ -z "$REPO_NAME" ]]; then
  echo "Error: REPO must be in format 'owner/name'" >&2
  exit 1
fi

REVIEW_BODY=$(gh api graphql -f query="query {
  repository(owner: \"$OWNER\", name: \"$REPO_NAME\") {
    pullRequest(number: $PR_NUMBER) {
      reviews(first: 100) {
        edges {
          node {
            databaseId
            body
          }
        }
      }
    }
  }
}" 2>/dev/null | jq -r ".data.repository.pullRequest.reviews.edges[] | select(.node.databaseId == $REVIEW_ID) | .node.body")

if [[ -z "$REVIEW_BODY" ]]; then
  echo "Error: Review not found" >&2
  exit 1
fi

if echo "$REVIEW_BODY" | grep -q "generated no new comments"; then
  exit 0
else
  exit 1
fi
