#!/bin/bash
#
# Rebase a PR's branch onto its base, trying progressively more aggressive
# fallback strategies so the AI doesn't have to manually decide which
# approach to use for each PR:
#
#   1. Direct rebase (git rebase origin/<BASE>)
#   2. Cherry-pick the PR's commits onto a fresh branch off origin/<BASE>,
#      squashed into a single commit
#   3. Per-file diff application (apply-pr-diffs), as a last resort when
#      cherry-pick conflicts
#
# By default this only prepares the result locally-it does NOT push. Force
# pushing a shared branch is a hard-to-reverse action, so pass --push to
# have this script do it; otherwise it prints the exact command to run.
#
# Usage: auto-rebase-pr [-r REPO] <PR_NUMBER> [--push] [--force]
# Example: auto-rebase-pr -r owner/repo 116
#          auto-rebase-pr -r owner/repo 116 --push
#          auto-rebase-pr 116 --push  # REPO derived from cwd's GitHub remote
#
# -r/REPO is optional: if not given, it's derived from the current
# directory's GitHub remote instead.
#
# Options:
#   -r REPO  Repository in owner/repo format (may appear anywhere in argv)
#   --push   Force-push the result to the PR's remote head branch
#   --force  Overwrite a pre-existing local <HEAD>-clean branch, if any
#
# Exit codes:
#   0 = Succeeded via direct rebase
#   1 = Succeeded via cherry-pick
#   2 = Succeeded via per-file diff application
#   3 = All strategies failed; manual intervention needed
#   4 = Invalid arguments or setup error
#   5 = Local result prepared successfully, but --push failed
#

set -e

# Parse -r REPO, which may appear before or after positional/other flag
# arguments - plain getopts stops at the first non-option arg, so this loop
# re-invokes it after setting aside each remaining token in turn.
REPO=""
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  if [[ "$1" == -* && "$1" != --* ]]; then
    OPTIND=1
    getopts ":r:" OPT
    case "$OPT" in
      r) REPO="$OPTARG" ;;
      :) echo "Error: -r requires an argument" >&2; exit 4 ;;
      \?) echo "Error: unknown option -$OPTARG" >&2; exit 4 ;;
    esac
    shift $((OPTIND - 1))
  else
    POSITIONAL+=("$1")
    shift
  fi
done
set -- "${POSITIONAL[@]}"

PUSH=0
FORCE=0
ARGS=()
for ARG in "$@"; do
  case "$ARG" in
    --push) PUSH=1 ;;
    --force) FORCE=1 ;;
    *) ARGS+=("$ARG") ;;
  esac
done

if [[ -z "$REPO" ]]; then
  REPO=$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null || true)
  if [[ -z "$REPO" ]]; then
    echo "Error: REPO not given (-r), and cwd is not a GitHub repo (run from inside a repo checkout, or pass -r REPO explicitly)" >&2
    exit 4
  fi
fi
PR_NUMBER="${ARGS[0]}"

if [[ -z "$PR_NUMBER" ]]; then
  echo "Usage: auto-rebase-pr [-r REPO] <PR_NUMBER> [--push] [--force]" >&2
  echo "Example: auto-rebase-pr -r owner/repo 116" >&2
  exit 4
fi

if ! git rev-parse --git-dir > /dev/null 2>&1; then
  echo "Error: Not inside a git repository" >&2
  exit 4
fi

PR_INFO=$(gh pr view "$PR_NUMBER" --repo "$REPO" --json baseRefName,headRefName,title 2>/dev/null || true)
if [[ -z "$PR_INFO" ]]; then
  echo "Error: Could not find PR #$PR_NUMBER on $REPO" >&2
  exit 4
fi
BASE=$(echo "$PR_INFO" | jq -r '.baseRefName')
HEAD=$(echo "$PR_INFO" | jq -r '.headRefName')
TITLE=$(echo "$PR_INFO" | jq -r '.title')

echo "════════════════════════════════════════════════════════════════"
echo "  auto-rebase-pr: $REPO #$PR_NUMBER ($HEAD -> $BASE)"
echo "════════════════════════════════════════════════════════════════"

git fetch origin "$BASE" "$HEAD" --quiet

push_result() {
  # $1 = local ref to push, $2 = 1 if it's a same-named branch (plain push), 0 if renaming a -clean branch
  local LOCAL_REF="$1"
  local SAME_NAME="$2"
  if [[ $PUSH -ne 1 ]]; then
    echo ""
    echo "Not pushed (pass --push to push automatically). To push manually:"
    if [[ "$SAME_NAME" == "1" ]]; then
      echo "  git push --force-with-lease origin $HEAD"
    else
      echo "  git push --force-with-lease=\"$HEAD:\$(git rev-parse origin/$HEAD)\" origin $LOCAL_REF:$HEAD"
    fi
    return 0
  fi
  echo ""
  echo "Pushing..."
  if [[ "$SAME_NAME" == "1" ]]; then
    if git push --force-with-lease origin "$HEAD"; then
      echo "✓ Pushed to origin/$HEAD"
    else
      echo "✗ Push failed" >&2
      return 1
    fi
  else
    local EXPECT
    EXPECT=$(git rev-parse "origin/$HEAD")
    if git push --force-with-lease="$HEAD:$EXPECT" origin "$LOCAL_REF:$HEAD"; then
      echo "✓ Pushed $LOCAL_REF to origin/$HEAD"
    else
      echo "✗ Push failed" >&2
      return 1
    fi
  fi
}

# --- Strategy 1: direct rebase -----------------------------------------------

echo ""
echo "Strategy 1: direct rebase"
if git checkout "$HEAD" > /dev/null 2>&1 || git checkout -b "$HEAD" "origin/$HEAD" > /dev/null 2>&1; then
  git reset --hard "origin/$HEAD" > /dev/null
  if git rebase "origin/$BASE" > /dev/null 2>&1; then
    echo "✓ Rebased cleanly onto origin/$BASE"
    if push_result "$HEAD" 1; then
      exit 0
    else
      exit 5
    fi
  else
    echo "✗ Conflicts; aborting rebase"
    git rebase --abort > /dev/null 2>&1 || true
  fi
else
  echo "✗ Could not check out $HEAD locally" >&2
  exit 4
fi

# --- Strategy 2: cherry-pick, squashed into one commit -----------------------

echo ""
echo "Strategy 2: cherry-pick onto a fresh branch"
CLEAN_BRANCH="${HEAD}-clean"

if git rev-parse --verify "$CLEAN_BRANCH" > /dev/null 2>&1 && [[ $FORCE -ne 1 ]]; then
  echo "✗ ERROR: Branch '$CLEAN_BRANCH' already exists locally"
  echo "  This usually means a prior rebase attempt left state behind."
  echo "  Options:"
  echo "    1. git branch -D $CLEAN_BRANCH && git branch -D $HEAD"
  echo "    2. Pass --force to overwrite (not recommended; review what's there first)"
  exit 6
fi

git checkout -B "$CLEAN_BRANCH" "origin/$BASE" > /dev/null 2>&1 || {
  echo "✗ Could not create $CLEAN_BRANCH based on origin/$BASE" >&2
  exit 4
}

CHERRY_FAILED=0
mapfile -t COMMITS < <(git log "origin/$BASE..origin/$HEAD" --reverse --format=%H)
if [[ ${#COMMITS[@]} -eq 0 ]]; then
  echo "✗ No commits found between origin/$BASE and origin/$HEAD"
  echo "  This could mean:"
  echo "    - PR base has already been updated and this PR is already up-to-date"
  echo "    - PR base branch doesn't exist or is incorrect"
  exit 3
fi

echo "  Cherry-picking ${#COMMITS[@]} commit(s)..."
for COMMIT in "${COMMITS[@]}"; do
  if ! git cherry-pick --no-commit "$COMMIT" > /dev/null 2>&1; then
    CHERRY_FAILED=1
    FAILED_COMMIT=$(git log -1 --format=%h "$COMMIT")
    echo "  ✗ Conflict at commit $FAILED_COMMIT"
    break
  fi
done

if [[ $CHERRY_FAILED -eq 1 ]]; then
  echo "✗ Cherry-pick failed; falling back to per-file diff application"
  # Clean up the failed cherry-pick state
  git cherry-pick --quit > /dev/null 2>&1 || true
  git reset --hard HEAD > /dev/null 2>&1 || true
  git checkout "$BASE" > /dev/null 2>&1 || git checkout - > /dev/null 2>&1 || true
  git branch -D "$CLEAN_BRANCH" > /dev/null 2>&1 || true
else
  if ! git commit -m "$TITLE" --quiet 2>/dev/null; then
    echo "✗ Failed to commit after cherry-pick"
    git reset --hard HEAD > /dev/null 2>&1 || true
    git branch -D "$CLEAN_BRANCH" > /dev/null 2>&1 || true
    exit 6
  fi
  echo "✓ Cherry-picked ${#COMMITS[@]} commit(s) into one commit on $CLEAN_BRANCH"
  echo "  (commit message is the PR title verbatim-review/amend before pushing)"
  if push_result "$CLEAN_BRANCH" 0; then
    exit 1
  else
    exit 5
  fi
fi

# --- Strategy 3: per-file diff application -----------------------------------

echo ""
echo "Strategy 3: per-file diff application"

if ! git checkout "$BASE" > /dev/null 2>&1; then
  echo "✗ Could not check out base branch $BASE" >&2
  exit 4
fi

APPLY_ARGS=(apply-pr-diffs "origin/$BASE" "origin/$HEAD" "$CLEAN_BRANCH")
[[ $FORCE -eq 1 ]] && APPLY_ARGS+=(--force)

APPLY_OUTPUT=$(mktemp)
set +e
"${APPLY_ARGS[@]}" > "$APPLY_OUTPUT" 2>&1
APPLY_EXIT=$?
set -e
if [[ $APPLY_EXIT -ne 0 ]]; then
  echo "✗ apply-pr-diffs failed with exit code $APPLY_EXIT" >&2
  echo "  Diagnostic output:" >&2
  sed 's/^/    /' "$APPLY_OUTPUT" >&2
  rm -f "$APPLY_OUTPUT"
  exit 3
fi
rm -f "$APPLY_OUTPUT"

# Verify the branch was created and is in a clean state
if ! git rev-parse --verify "$CLEAN_BRANCH" > /dev/null 2>&1; then
  echo "✗ apply-pr-diffs completed but $CLEAN_BRANCH was not created" >&2
  exit 6
fi

# apply-pr-diffs stages changes but never commits, so the working tree will
# always differ from $CLEAN_BRANCH's own tip at this point-that's expected,
# not a problem. What we actually need to verify is that everything is
# staged (nothing left as loose unstaged edits) and that something IS
# staged (apply-pr-diffs did real work).
if ! git diff --quiet; then
  echo "✗ apply-pr-diffs completed but left unstaged changes on $CLEAN_BRANCH" >&2
  git status --short >&2
  exit 6
fi

if git diff --cached --quiet; then
  echo "✗ apply-pr-diffs completed but nothing is staged on $CLEAN_BRANCH" >&2
  exit 6
fi

if ! git commit -m "$TITLE" --quiet 2>/dev/null; then
  echo "✗ Failed to commit after diff-apply"
  git reset --hard HEAD > /dev/null 2>&1 || true
  git branch -D "$CLEAN_BRANCH" > /dev/null 2>&1 || true
  exit 6
fi

echo "✓ Diff-applied and committed on $CLEAN_BRANCH"
echo "  (commit message is the PR title verbatim-review/amend before pushing)"
if push_result "$CLEAN_BRANCH" 0; then
  exit 2
else
  exit 5
fi
