#!/bin/bash
#
# Find the databaseId of the latest GitHub Copilot review on a PR.
#
# Usage: latest-copilot-review-id [-r REPO] <PR_NUMBER>
# Example: latest-copilot-review-id -r owner/repo 116
#          latest-copilot-review-id 116  # REPO derived from cwd
#
# -r/REPO is optional: if not given, it's derived from the current
# directory's GitHub remote instead.
#
# Output: Just the databaseId (suitable for piping to other tools)
#

set -e

REPO=""
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  if [[ "$1" == -* && "$1" != --* ]]; then
    OPTIND=1
    getopts ":r:" OPT
    case "$OPT" in
      r) REPO="$OPTARG" ;;
      :) echo "Error: -r requires an argument" >&2; exit 1 ;;
      \?) echo "Error: unknown option -$OPTARG" >&2; exit 1 ;;
    esac
    shift $((OPTIND - 1))
  else
    POSITIONAL+=("$1")
    shift
  fi
done
set -- "${POSITIONAL[@]}"

if [[ -z "$REPO" ]]; then
  REPO=$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null || true)
  if [[ -z "$REPO" ]]; then
    echo "Error: REPO not given (-r), and cwd is not a GitHub repo (run from inside a repo checkout, or pass -r REPO explicitly)" >&2
    exit 1
  fi
fi
PR_NUMBER="$1"

if [[ -z "$PR_NUMBER" ]]; then
  echo "Usage: latest-copilot-review-id [-r REPO] <PR_NUMBER>" >&2
  echo "Example: latest-copilot-review-id -r owner/repo 116" >&2
  exit 1
fi

IFS='/' read -r OWNER REPO_NAME <<< "$REPO"
if [[ -z "$REPO_NAME" ]]; then
  echo "Error: REPO must be in format 'owner/name'" >&2
  exit 1
fi

REVIEWS_JSON=$(gh api graphql \
  -f query="query {
  repository(owner: \"$OWNER\", name: \"$REPO_NAME\") {
    pullRequest(number: $PR_NUMBER) {
      reviews(first: 100) {
        edges {
          node {
            databaseId
            author {
              login
            }
          }
        }
      }
    }
  }
}" 2>/dev/null)

LATEST_ID=$(echo "$REVIEWS_JSON" | jq -r '.data.repository.pullRequest.reviews.edges[] | select(.node.author.login == "copilot-pull-request-reviewer") | .node.databaseId' | tail -1)

if [[ -z "$LATEST_ID" ]]; then
  echo "Error: No Copilot reviews found on $REPO #$PR_NUMBER" >&2
  exit 1
fi

echo "$LATEST_ID"
