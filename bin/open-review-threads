#!/bin/bash
#
# Get all open (unresolved) review threads on a PR.
#
# Usage: open-review-threads <REPO> <PR_NUMBER> [--json]
# Example: open-review-threads owner/repo 116
#
# Output: Human-readable list of unresolved threads (one per line)
#   Format: path:line - comment_text
#
# Options:
#   --json    Output raw JSON objects (one per line) instead of formatted text
#

set -e

REPO="$1"
PR_NUMBER="$2"
OUTPUT_FORMAT="text"  # default to human-readable text

# Check for --json flag
if [[ "$3" == "--json" ]]; then
  OUTPUT_FORMAT="json"
fi

if [[ -z "$REPO" ]] || [[ -z "$PR_NUMBER" ]]; then
  echo "Usage: open-review-threads <REPO> <PR_NUMBER> [--json]" >&2
  echo "Example: open-review-threads owner/repo 116" >&2
  echo "" >&2
  echo "Output formats:" >&2
  echo "  text (default): path:line - comment" >&2
  echo "  --json: Raw JSON objects (one per line)" >&2
  exit 1
fi

IFS='/' read -r OWNER REPO_NAME <<< "$REPO"
if [[ -z "$REPO_NAME" ]]; then
  echo "Error: REPO must be in format 'owner/name'" >&2
  exit 1
fi

# Fetch threads
THREADS=$(gh api graphql -f query="query {
  repository(owner: \"$OWNER\", name: \"$REPO_NAME\") {
    pullRequest(number: $PR_NUMBER) {
      reviewThreads(first: 50) {
        edges {
          node {
            id
            isResolved
            path
            line
            comments(first: 1) {
              edges {
                node {
                  body
                  author {
                    login
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}" 2>/dev/null | jq '.data.repository.pullRequest.reviewThreads.edges[] | select(.node.isResolved == false) | {id: .node.id, path: .node.path, line: .node.line, author: .node.comments.edges[0].node.author.login, body: .node.comments.edges[0].node.body}')

# Output based on format
if [[ "$OUTPUT_FORMAT" == "json" ]]; then
  # Raw JSON (one object per line)
  echo "$THREADS"
else
  # Human-readable formatted text
  echo "$THREADS" | jq -r '"  \(.path):\(.line) - \(.body)"'
fi
