#!/bin/bash
#
# Get all open (unresolved) review threads on a PR.
#
# Usage: open-review-threads [-r REPO] <PR_NUMBER> [--json]
# Example: open-review-threads -r owner/repo 116
#          open-review-threads 116  # REPO derived from cwd
#
# -r/REPO is optional: if not given, it's derived from the current
# directory's GitHub remote instead.
#
# Output: Human-readable list of unresolved threads (one per line)
#   Format: path:line - comment_text
#
# Options:
#   -r REPO   Repository in owner/repo format (may appear anywhere in argv)
#   --json    Output raw JSON objects (one per line) instead of formatted text
#

set -e

REPO=""
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  if [[ "$1" == -* && "$1" != --* ]]; then
    OPTIND=1
    getopts ":r:" OPT
    case "$OPT" in
      r) REPO="$OPTARG" ;;
      :) echo "Error: -r requires an argument" >&2; exit 1 ;;
      \?) echo "Error: unknown option -$OPTARG" >&2; exit 1 ;;
    esac
    shift $((OPTIND - 1))
  else
    POSITIONAL+=("$1")
    shift
  fi
done
set -- "${POSITIONAL[@]}"

if [[ -z "$REPO" ]]; then
  REPO=$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null || true)
  if [[ -z "$REPO" ]]; then
    echo "Error: REPO not given (-r), and cwd is not a GitHub repo (run from inside a repo checkout, or pass -r REPO explicitly)" >&2
    exit 1
  fi
fi
PR_NUMBER="$1"
OUTPUT_FORMAT="text"  # default to human-readable text

# Check for --json flag
if [[ "$2" == "--json" ]]; then
  OUTPUT_FORMAT="json"
fi

if [[ -z "$PR_NUMBER" ]]; then
  echo "Usage: open-review-threads [-r REPO] <PR_NUMBER> [--json]" >&2
  echo "Example: open-review-threads owner/repo 116" >&2
  echo "" >&2
  echo "Output formats:" >&2
  echo "  text (default): path:line - comment" >&2
  echo "  --json: Raw JSON objects (one per line)" >&2
  exit 1
fi

IFS='/' read -r OWNER REPO_NAME <<< "$REPO"
if [[ -z "$REPO_NAME" ]]; then
  echo "Error: REPO must be in format 'owner/name'" >&2
  exit 1
fi

# Fetch threads, paginating so unresolved threads beyond the first page aren't missed
THREADS=""
CURSOR=""
while :; do
  CURSOR_ARGS=()
  if [[ -n "$CURSOR" ]]; then
    CURSOR_ARGS=(-f cursor="$CURSOR")
  fi
  PAGE=$(gh api graphql \
    -f owner="$OWNER" -f name="$REPO_NAME" -F number="$PR_NUMBER" "${CURSOR_ARGS[@]}" \
    -f query='query($owner: String!, $name: String!, $number: Int!, $cursor: String) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      reviewThreads(first: 100, after: $cursor) {
        pageInfo {
          hasNextPage
          endCursor
        }
        edges {
          node {
            id
            isResolved
            path
            line
            comments(first: 1) {
              edges {
                node {
                  body
                  author {
                    login
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}' 2>/dev/null)

  PAGE_THREADS=$(echo "$PAGE" | jq '.data.repository.pullRequest.reviewThreads.edges[] | select(.node.isResolved == false) | {id: .node.id, path: .node.path, line: .node.line, author: .node.comments.edges[0].node.author.login, body: .node.comments.edges[0].node.body}')
  if [[ -n "$PAGE_THREADS" ]]; then
    THREADS+="${THREADS:+$'\n'}$PAGE_THREADS"
  fi

  HAS_NEXT=$(echo "$PAGE" | jq -r '.data.repository.pullRequest.reviewThreads.pageInfo.hasNextPage')
  [[ "$HAS_NEXT" == "true" ]] || break
  CURSOR=$(echo "$PAGE" | jq -r '.data.repository.pullRequest.reviewThreads.pageInfo.endCursor')
done

# Output based on format
if [[ "$OUTPUT_FORMAT" == "json" ]]; then
  # Raw JSON (one object per line)
  echo "$THREADS"
else
  # Human-readable formatted text
  echo "$THREADS" | jq -r '"  \(.path):\(.line) - \(.body)"'
fi
