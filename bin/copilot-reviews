#!/bin/bash
#
# Get all open (unhidden) GitHub Copilot reviews on a PR.
#
# Usage: copilot-reviews [-r REPO] <PR_NUMBER> [--json]
# Example: copilot-reviews -r owner/repo 116
#          copilot-reviews 116  # REPO derived from cwd
#
# -r/REPO is optional: if not given, it's derived from the current
# directory's GitHub remote instead.
#
# Output: Human-readable reviews with ID and full body text
#   Format: Review #<databaseId>:\n<body>\n---
#
# Options:
#   -r REPO   Repository in owner/repo format (may appear anywhere in argv)
#   --json    Output raw JSON objects (one per line) instead of formatted text
#

set -e

REPO=""
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  if [[ "$1" == -* && "$1" != --* ]]; then
    OPTIND=1
    getopts ":r:" OPT
    case "$OPT" in
      r) REPO="$OPTARG" ;;
      :) echo "Error: -r requires an argument" >&2; exit 1 ;;
      \?) echo "Error: unknown option -$OPTARG" >&2; exit 1 ;;
    esac
    shift $((OPTIND - 1))
  else
    POSITIONAL+=("$1")
    shift
  fi
done
set -- "${POSITIONAL[@]}"

if [[ -z "$REPO" ]]; then
  REPO=$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null || true)
  if [[ -z "$REPO" ]]; then
    echo "Error: REPO not given (-r), and cwd is not a GitHub repo (run from inside a repo checkout, or pass -r REPO explicitly)" >&2
    exit 1
  fi
fi
PR_NUMBER="$1"
OUTPUT_FORMAT="text"  # default to human-readable text

# Check for --json flag
if [[ "$2" == "--json" ]]; then
  OUTPUT_FORMAT="json"
fi

if [[ -z "$PR_NUMBER" ]]; then
  echo "Usage: copilot-reviews [-r REPO] <PR_NUMBER> [--json]" >&2
  echo "Example: copilot-reviews -r owner/repo 116" >&2
  echo "" >&2
  echo "Output formats:" >&2
  echo "  text (default): Review #<id>:\\n<body>\\n---" >&2
  echo "  --json: Raw JSON objects (one per line)" >&2
  exit 1
fi

IFS='/' read -r OWNER REPO_NAME <<< "$REPO"
if [[ -z "$REPO_NAME" ]]; then
  echo "Error: REPO must be in format 'owner/name'" >&2
  exit 1
fi

# Fetch reviews
REVIEWS=$(gh api graphql -f query="query {
  repository(owner: \"$OWNER\", name: \"$REPO_NAME\") {
    pullRequest(number: $PR_NUMBER) {
      reviews(first: 100) {
        edges {
          node {
            id
            databaseId
            isMinimized
            body
            author {
              login
            }
          }
        }
      }
    }
  }
}" 2>/dev/null | jq '.data.repository.pullRequest.reviews.edges[] | select(.node.author.login == "copilot-pull-request-reviewer" and (.node.isMinimized // false) == false) | {id: .node.id, databaseId: .node.databaseId, body: .node.body}')

# Output based on format
if [[ "$OUTPUT_FORMAT" == "json" ]]; then
  # Raw JSON (one object per line)
  echo "$REVIEWS"
else
  # Human-readable formatted text
  echo "$REVIEWS" | jq -r '"Review #\(.databaseId):\n\(.body)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"'
fi
