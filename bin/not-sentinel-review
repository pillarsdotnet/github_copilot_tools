#!/bin/bash
#
# Check if a Copilot review is NOT a sentinel (has outstanding comments).
#
# A sentinel review contains "generated no new comments", meaning Copilot
# found no new issues to report. This script returns 0 if the review is
# NOT a sentinel (still has outstanding comments).
#
# Usage: not-sentinel-review [-r REPO] <PR_NUMBER> <REVIEW_DATABASE_ID>
# Example: not-sentinel-review -r owner/repo 116 4964619882
#          not-sentinel-review 116 4964619882  # REPO derived from cwd
#
# -r/REPO is optional: if not given, it's derived from the current
# directory's GitHub remote instead.
#
# Exit codes:
#   0 = Review is NOT a sentinel (has comments that need addressing)
#   1 = Review IS a sentinel (no new comments found)
#   2 = Review not found or error
#

set -e

REPO=""
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  if [[ "$1" == -* && "$1" != --* ]]; then
    OPTIND=1
    getopts ":r:" OPT
    case "$OPT" in
      r) REPO="$OPTARG" ;;
      :) echo "Error: -r requires an argument" >&2; exit 2 ;;
      \?) echo "Error: unknown option -$OPTARG" >&2; exit 2 ;;
    esac
    shift $((OPTIND - 1))
  else
    POSITIONAL+=("$1")
    shift
  fi
done
set -- "${POSITIONAL[@]}"

if [[ -z "$REPO" ]]; then
  REPO=$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null || true)
  if [[ -z "$REPO" ]]; then
    echo "Error: REPO not given (-r), and cwd is not a GitHub repo (run from inside a repo checkout, or pass -r REPO explicitly)" >&2
    exit 2
  fi
fi
PR_NUMBER="$1"
REVIEW_ID="$2"

if [[ -z "$PR_NUMBER" ]] || [[ -z "$REVIEW_ID" ]]; then
  echo "Usage: not-sentinel-review [-r REPO] <PR_NUMBER> <REVIEW_DATABASE_ID>" >&2
  echo "Example: not-sentinel-review -r owner/repo 116 4964619882" >&2
  exit 2
fi

IFS='/' read -r OWNER REPO_NAME <<< "$REPO"
if [[ -z "$REPO_NAME" ]]; then
  echo "Error: REPO must be in format 'owner/name'" >&2
  exit 2
fi

REVIEW_BODY=$(gh api graphql -f query="query {
  repository(owner: \"$OWNER\", name: \"$REPO_NAME\") {
    pullRequest(number: $PR_NUMBER) {
      reviews(first: 100) {
        edges {
          node {
            databaseId
            body
          }
        }
      }
    }
  }
}" 2>/dev/null | jq -r ".data.repository.pullRequest.reviews.edges[] | select(.node.databaseId == $REVIEW_ID) | .node.body")

if [[ -z "$REVIEW_BODY" ]]; then
  echo "Error: Review not found" >&2
  exit 2
fi

if echo "$REVIEW_BODY" | grep -q "generated no new comments"; then
  # This IS a sentinel, so NOT a sentinel = false (exit 1)
  exit 1
elif echo "$REVIEW_BODY" | grep -q "Copilot encountered an error"; then
  # Error reviews are non-blocking (treat as sentinels), so NOT a sentinel = false (exit 1)
  exit 1
else
  # This is NOT a sentinel, so NOT a sentinel = true (exit 0)
  exit 0
fi
