#!/bin/bash
#
# Resolve review threads, hide stale reviews, and check if a new Copilot review is needed.
#
# Performs the following actions:
#   1. Resolve all open review threads (inline code comments)
#   2. Hide stale/old reviews as "Resolved"
#   3. Determine whether a new review is needed based on:
#      - All previous reviews being resolved (sentinels)
#      - Files having been changed since the last review
#
# Usage: refresh-needed <REPO> <PR_NUMBER> <FILES_CHANGED_COUNT>
# Example: refresh-needed owner/repo 116 3
#
# Arguments:
#   REPO                 Repository in format owner/repo-name
#   PR_NUMBER            Pull request number
#   FILES_CHANGED_COUNT  Number of files changed since last review (from check-changed-files)
#
# Exit codes:
#   0 = New review IS needed (all reviews resolved AND files changed)
#   1 = New review NOT needed (no changes or reviews still outstanding)
#

set -e

REPO="$1"
PR_NUM="$2"
FILES_CHANGED="$3"

# Validation
if [[ -z "$REPO" ]] || [[ -z "$PR_NUM" ]] || [[ -z "$FILES_CHANGED" ]]; then
  echo "Usage: refresh-needed <REPO> <PR_NUMBER> <FILES_CHANGED_COUNT>" >&2
  echo "Example: refresh-needed owner/repo 116 3" >&2
  exit 1
fi

# Check if FILES_CHANGED is a valid number
if ! [[ "$FILES_CHANGED" =~ ^[0-9]+$ ]]; then
  echo "Error: FILES_CHANGED_COUNT must be a number" >&2
  exit 1
fi

echo "════════════════════════════════════════════════════════════════"
echo "  Step 1: Resolve open review threads"
echo "════════════════════════════════════════════════════════════════"
resolve-pr-review-threads "$REPO" "$PR_NUM" || true
echo ""

echo "════════════════════════════════════════════════════════════════"
echo "  Step 2: Hide stale/old reviews"
echo "════════════════════════════════════════════════════════════════"

IFS='/' read -r OWNER REPO_NAME <<< "$REPO"
if [[ -z "$REPO_NAME" ]]; then
  echo "Error: REPO must be in format 'owner/name'" >&2
  exit 1
fi

REVIEW_IDS=$(review-database-ids "$REPO" "$PR_NUM" 2>/dev/null || echo "")
HIDDEN_COUNT=0
ERROR_REVIEW_COUNT=0

if [[ -z "$REVIEW_IDS" ]]; then
  echo "No reviews found for this PR"
else
  # Get all reviews and identify which ones to hide
  REVIEWS=$(gh api graphql -f query="query {
  repository(owner: \"$OWNER\", name: \"$REPO_NAME\") {
    pullRequest(number: $PR_NUM) {
      reviews(first: 100) {
        nodes {
          databaseId
          state
          body
          comments(first: 1) {
            nodes {
              id
            }
          }
        }
      }
    }
  }
}" 2>/dev/null)

  for ID in $REVIEW_IDS; do
    REVIEW_DATA=$(echo "$REVIEWS" | jq ".data.repository.pullRequest.reviews.nodes[] | select(.databaseId == $ID)")
    
    if [[ -z "$REVIEW_DATA" ]]; then
      continue
    fi
    
    REVIEW_BODY=$(echo "$REVIEW_DATA" | jq -r '.body')
    COMMENT_ID=$(echo "$REVIEW_DATA" | jq -r '.comments.nodes[0].id')
    
    # Check if this is an error review
    if echo "$REVIEW_BODY" | grep -q "Copilot encountered an error"; then
      ERROR_REVIEW_COUNT=$((ERROR_REVIEW_COUNT + 1))
      echo "Skipping error review $ID (cannot be hidden; treating as resolved)"
      continue
    fi
    
    # Check if this is a sentinel review (no new comments)
    if echo "$REVIEW_BODY" | grep -q "generated no new comments"; then
      # Don't hide sentinel reviews—they serve as checkpoints showing when we last reviewed
      continue
    fi
    
    # This review has comments and is not a sentinel—try to hide it
    if [[ ! -z "$COMMENT_ID" ]] && [[ "$COMMENT_ID" != "null" ]]; then
      echo "Hiding review $ID..."
      
      RESULT=$(gh api graphql -f commentId="$COMMENT_ID" -f query='
mutation($commentId: ID!) {
  minimizeComment(input: {subjectId: $commentId, classifier: RESOLVED}) {
    minimizedComment {
      isMinimized
    }
  }
}
' 2>/dev/null || echo '{"data":{"minimizeComment":null}}')
      
      IS_MINIMIZED=$(echo "$RESULT" | jq -r '.data.minimizeComment.minimizedComment.isMinimized // false')
      
      if [[ "$IS_MINIMIZED" == "true" ]]; then
        HIDDEN_COUNT=$((HIDDEN_COUNT + 1))
      fi
    fi
  done
fi

if [[ $HIDDEN_COUNT -gt 0 ]]; then
  echo "✓ Hidden $HIDDEN_COUNT review(s)"
fi
if [[ $ERROR_REVIEW_COUNT -gt 0 ]]; then
  echo "⚠ Treating $ERROR_REVIEW_COUNT error review(s) as resolved"
fi
echo ""

echo "════════════════════════════════════════════════════════════════"
echo "  Step 3: Determine if new review is needed"
echo "════════════════════════════════════════════════════════════════"

# A new review is needed if:
# 1. All reviews are sentinels (no outstanding comments)
# 2. AND files have been changed (FILES_CHANGED > 0)

ALL_SENTINEL=1
for ID in $REVIEW_IDS; do
  if not-sentinel-review "$REPO" "$PR_NUM" "$ID" 2>/dev/null; then
    # Review is NOT a sentinel (has outstanding comments)
    ALL_SENTINEL=0
    break
  fi
done

# Return 0 if new review is needed
if [[ $ALL_SENTINEL -eq 1 ]] && [[ $FILES_CHANGED -gt 0 ]]; then
  echo "✓ New review needed: All previous reviews resolved, $FILES_CHANGED file(s) changed"
  exit 0
else
  echo "✗ New review not needed:"
  if [[ $ALL_SENTINEL -eq 0 ]]; then
    echo "  - Outstanding comments remain in previous reviews"
  fi
  if [[ $FILES_CHANGED -eq 0 ]]; then
    echo "  - No files changed since last review"
  fi
  exit 1
fi
