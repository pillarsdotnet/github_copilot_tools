#!/bin/bash
#
# Resolve review threads, hide stale reviews, and check if a new Copilot review is needed.
#
# Performs the following actions:
#   1. Resolve all open review threads (inline code comments)
#   2. Hide stale/old reviews:
#      - Non-sentinel reviews (those with actionable comments)
#      - Sentinel reviews with subsequent changes (outdated checkpoints)
#   3. Determine whether a new review is needed based on:
#      - All remaining reviews being sentinels
#      - Files having been changed since the last review
#
# Exit codes:
#   0 = New review IS needed (all reviews are sentinels AND files changed)
#   1 = New review NOT needed (reviews remain OR no file changes)
#
# Note: There should be at most one sentinel review per PR. Sentinel reviews
# represent a "clean" checkpoint ("generated no new comments" and zero
# suppressed comments) and become outdated if new changes are made.
#
# Usage: refresh-needed [-r REPO] <PR_NUMBER> <FILES_CHANGED_COUNT>
# Example: refresh-needed -r owner/repo 116 3
#          refresh-needed 116 3  # REPO derived from cwd
#
# Arguments:
#   -r REPO               Repository in format owner/repo-name (optional; if
#                          not given, it's derived from the cwd's GitHub
#                          remote instead)
#   PR_NUMBER            Pull request number
#   FILES_CHANGED_COUNT  Number of files changed since last review (from check-changed-files)
#

set -e

REPO=""
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  if [[ "$1" == -* && "$1" != --* ]]; then
    OPTIND=1
    getopts ":r:" OPT
    case "$OPT" in
      r) REPO="$OPTARG" ;;
      :) echo "Error: -r requires an argument" >&2; exit 1 ;;
      \?) echo "Error: unknown option -$OPTARG" >&2; exit 1 ;;
    esac
    shift $((OPTIND - 1))
  else
    POSITIONAL+=("$1")
    shift
  fi
done
set -- "${POSITIONAL[@]}"

if [[ -z "$REPO" ]]; then
  REPO=$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null || true)
  if [[ -z "$REPO" ]]; then
    echo "Error: REPO not given (-r), and cwd is not a GitHub repo (run from inside a repo checkout, or pass -r REPO explicitly)" >&2
    exit 1
  fi
fi
PR_NUM="$1"
FILES_CHANGED="$2"

# Validation
if [[ -z "$PR_NUM" ]] || [[ -z "$FILES_CHANGED" ]]; then
  echo "Usage: refresh-needed [-r REPO] <PR_NUMBER> <FILES_CHANGED_COUNT>" >&2
  echo "Example: refresh-needed -r owner/repo 116 3" >&2
  exit 1
fi

# Check if FILES_CHANGED is a valid number
if ! [[ "$FILES_CHANGED" =~ ^[0-9]+$ ]]; then
  echo "Error: FILES_CHANGED_COUNT must be a number" >&2
  exit 1
fi

echo "════════════════════════════════════════════════════════════════"
echo "  Step 1: Resolve open review threads"
echo "════════════════════════════════════════════════════════════════"
resolve-pr-review-threads -r "$REPO" "$PR_NUM" || true
echo ""

echo "════════════════════════════════════════════════════════════════"
echo "  Step 2: Hide stale/old reviews"
echo "════════════════════════════════════════════════════════════════"

IFS='/' read -r OWNER REPO_NAME <<< "$REPO"
if [[ -z "$REPO_NAME" ]]; then
  echo "Error: REPO must be in format 'owner/name'" >&2
  exit 1
fi

mapfile -t REVIEW_IDS < <(review-database-ids -r "$REPO" "$PR_NUM" 2>/dev/null || true)
HIDDEN_COUNT=0
REVIEW_COUNT=${#REVIEW_IDS[@]}

# Hide all reviews except the last one.
if [[ $REVIEW_COUNT -gt 1 ]]; then
  for ((i=0; i<REVIEW_COUNT-1; i++)); do
    ID="${REVIEW_IDS[$i]}"
    echo "Hiding stale review $ID..."
    hide-pr-review -r "$REPO" "$PR_NUM" "$ID" 2>/dev/null || true
    HIDDEN_COUNT=$((HIDDEN_COUNT + 1))
  done
fi

echo ""
if [[ $HIDDEN_COUNT -gt 0 ]]; then
  echo "✓ Hidden $HIDDEN_COUNT review(s)"
fi
echo ""

echo "════════════════════════════════════════════════════════════════"
echo "  Step 3: Determine if new review is needed"
echo "════════════════════════════════════════════════════════════════"

# Decision flow based on the last remaining review.
if [[ $REVIEW_COUNT -eq 0 ]]; then
  if (( FILES_CHANGED )); then
    echo "✓ New review needed: No open reviews remain, $FILES_CHANGED file(s) changed"
    exit 0
  fi
  echo "✗ New review not needed:"
  echo "  - No open reviews and no files changed since last review (pure rebase)"
  exit 1
fi

LAST_ID="${REVIEW_IDS[$((REVIEW_COUNT - 1))]}"
if is-sentinel-review -r "$REPO" "$PR_NUM" "$LAST_ID" 2>/dev/null; then
  # Sentinel review exists. Check if it's still valid (no changes after review).
  if (( FILES_CHANGED )); then
    # Files changed after sentinel review - sentinel is now stale, must hide it
    echo "Hiding stale sentinel review $LAST_ID (new commits after review)..."
    hide-pr-review -r "$REPO" "$PR_NUM" "$LAST_ID" 2>/dev/null || true
    echo "✓ New review needed: Sentinel review hidden due to $FILES_CHANGED new file change(s)"
    exit 0
  fi
  # No files changed - sentinel is still valid
  echo "Keeping sentinel review $LAST_ID (latest review is already a clean checkpoint)"
  echo "✗ New review not needed:"
  echo "  - Latest open review is a sentinel with no changes since review"
  exit 1
fi

echo "Hiding latest non-sentinel review $LAST_ID..."
hide-pr-review -r "$REPO" "$PR_NUM" "$LAST_ID" 2>/dev/null || true
HIDDEN_COUNT=$((HIDDEN_COUNT + 1))
echo "✓ New review needed: Latest review was non-sentinel and has been hidden"
exit 0
