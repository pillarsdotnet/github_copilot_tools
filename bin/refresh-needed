#!/bin/bash
#
# Resolve review threads, hide stale reviews, and check if a new Copilot review is needed.
#
# Performs the following actions:
#   1. Resolve all open review threads (inline code comments)
#   2. Hide stale/old reviews:
#      - Non-sentinel reviews (those with actionable comments)
#      - Sentinel reviews with subsequent changes (outdated checkpoints)
#   3. Determine whether a new review is needed based on:
#      - All remaining reviews being sentinels
#      - Files having been changed since the last review
#
# Exit codes:
#   0 = New review IS needed (all reviews are sentinels AND files changed)
#   1 = New review NOT needed (reviews remain OR no file changes)
#
# Note: There should be at most one sentinel review per PR. Sentinel reviews
# represent a "clean" checkpoint and become outdated if new changes are made.
#
# Usage: refresh-needed <REPO> <PR_NUMBER> <FILES_CHANGED_COUNT>
# Example: refresh-needed owner/repo 116 3
#
# Arguments:
#   REPO                 Repository in format owner/repo-name
#   PR_NUMBER            Pull request number
#   FILES_CHANGED_COUNT  Number of files changed since last review (from check-changed-files)
#

set -e

REPO="$1"
PR_NUM="$2"
FILES_CHANGED="$3"

# Validation
if [[ -z "$REPO" ]] || [[ -z "$PR_NUM" ]] || [[ -z "$FILES_CHANGED" ]]; then
  echo "Usage: refresh-needed <REPO> <PR_NUMBER> <FILES_CHANGED_COUNT>" >&2
  echo "Example: refresh-needed owner/repo 116 3" >&2
  exit 1
fi

# Check if FILES_CHANGED is a valid number
if ! [[ "$FILES_CHANGED" =~ ^[0-9]+$ ]]; then
  echo "Error: FILES_CHANGED_COUNT must be a number" >&2
  exit 1
fi

echo "════════════════════════════════════════════════════════════════"
echo "  Step 1: Resolve open review threads"
echo "════════════════════════════════════════════════════════════════"
resolve-pr-review-threads "$REPO" "$PR_NUM" || true
echo ""

echo "════════════════════════════════════════════════════════════════"
echo "  Step 2: Hide stale/old reviews"
echo "════════════════════════════════════════════════════════════════"

IFS='/' read -r OWNER REPO_NAME <<< "$REPO"
if [[ -z "$REPO_NAME" ]]; then
  echo "Error: REPO must be in format 'owner/name'" >&2
  exit 1
fi

REVIEW_IDS=$(review-database-ids "$REPO" "$PR_NUM" 2>/dev/null || echo "")
HIDDEN_COUNT=0
SKIPPED_COUNT=0

for ID in $REVIEW_IDS; do
  # Check if this is a sentinel review
  if is-sentinel-review "$REPO" "$PR_NUM" "$ID" 2>/dev/null; then
    # This IS a sentinel review
    if (( FILES_CHANGED )); then
      # Sentinel reviews become outdated when new changes are made
      echo "Hiding outdated sentinel review $ID..."
      hide-pr-review "$REPO" "$PR_NUM" "$ID" 2>/dev/null || true
      HIDDEN_COUNT=$((HIDDEN_COUNT + 1))
    else
      # No changes; keep the sentinel review as a checkpoint
      echo "Keeping sentinel review $ID (no new changes)"
      SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
    fi
  else
    # This is NOT a sentinel—it has actionable comments
    echo "Hiding review $ID (outstanding comments)..."
    hide-pr-review "$REPO" "$PR_NUM" "$ID" 2>/dev/null || true
    HIDDEN_COUNT=$((HIDDEN_COUNT + 1))
  fi
done

echo ""
if [[ $HIDDEN_COUNT -gt 0 ]]; then
  echo "✓ Hidden $HIDDEN_COUNT review(s)"
fi
if [[ $SKIPPED_COUNT -gt 0 ]]; then
  echo "✓ Kept $SKIPPED_COUNT sentinel review(s) as checkpoint"
fi
echo ""

echo "════════════════════════════════════════════════════════════════"
echo "  Step 3: Determine if new review is needed"
echo "════════════════════════════════════════════════════════════════"

# A new review is needed if:
# 1. All remaining reviews are sentinels (no outstanding comments)
# 2. AND files have been changed (FILES_CHANGED > 0)

ALL_SENTINEL=1
for ID in $REVIEW_IDS; do
  if ! is-sentinel-review "$REPO" "$PR_NUM" "$ID" 2>/dev/null; then
    # Review is NOT a sentinel (has outstanding comments)
    ALL_SENTINEL=0
    break
  fi
done

# Determine exit code
if [[ $ALL_SENTINEL -eq 1 ]] && (( FILES_CHANGED )); then
  echo "✓ New review needed: All reviews resolved, $FILES_CHANGED file(s) changed"
  exit 0
else
  echo "✗ New review not needed:"
  if [[ $ALL_SENTINEL -eq 0 ]]; then
    echo "  - Outstanding comments remain in previous reviews"
  fi
  if ! (( FILES_CHANGED )); then
    echo "  - No files changed since last review (pure rebase)"
  fi
  exit 1
fi
