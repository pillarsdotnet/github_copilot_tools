#!/bin/bash
#
# Extract databaseId values from copilot-reviews output.
#
# Outputs all databaseId values from copilot-reviews, one per line.
# Useful for piping to other commands or looping over review IDs.
#
# Usage: review-database-ids [-r REPO] <PR_NUMBER>
# Example: review-database-ids -r owner/repo 116
#          review-database-ids 116  # REPO derived from cwd
#
# -r/REPO is optional: if not given, it's derived from the current
# directory's GitHub remote instead.
#
# Output: One databaseId per line
#
# Examples:
#   # List all review IDs
#   review-database-ids owner/repo 116
#
#   # Loop over review IDs
#   review-database-ids owner/repo 116 | while read id; do
#     echo "Review: $id"
#   done
#
#   # Store in a variable (bash array)
#   mapfile -t REVIEW_IDS < <(review-database-ids owner/repo 116)
#
#   # Count reviews
#   review-database-ids owner/repo 116 | wc -l
#
# Exit codes:
#   0 = Success (even if no reviews found)
#   1 = Invalid arguments
#

# Arguments: -r/REPO is optional (see header comment above).
REPO=""
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  if [[ "$1" == -* && "$1" != --* ]]; then
    OPTIND=1
    getopts ":r:" OPT
    case "$OPT" in
      r) REPO="$OPTARG" ;;
      :) echo "Error: -r requires an argument" >&2; exit 1 ;;
      \?) echo "Error: unknown option -$OPTARG" >&2; exit 1 ;;
    esac
    shift $((OPTIND - 1))
  else
    POSITIONAL+=("$1")
    shift
  fi
done
set -- "${POSITIONAL[@]}"

if [[ -z "$REPO" ]]; then
  REPO=$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null || true)
  if [[ -z "$REPO" ]]; then
    echo "Error: REPO not given (-r), and cwd is not a GitHub repo (run from inside a repo checkout, or pass -r REPO explicitly)" >&2
    exit 1
  fi
fi
PR_NUMBER="$1"

# Validation
if [[ -z "$PR_NUMBER" ]]; then
  echo "Usage: review-database-ids [-r REPO] <PR_NUMBER>" >&2
  echo "Example: review-database-ids -r owner/repo 116" >&2
  exit 1
fi

# Parse repo
IFS='/' read -r OWNER REPO_NAME <<< "$REPO"
if [[ -z "$REPO_NAME" ]]; then
  echo "Error: REPO must be in format 'owner/name'" >&2
  exit 1
fi

# Find copilot-reviews script
# Try: same directory as this script, then PATH
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -x "$SCRIPT_DIR/copilot-reviews" ]]; then
  COPILOT_REVIEWS="$SCRIPT_DIR/copilot-reviews"
else
  COPILOT_REVIEWS="copilot-reviews"
fi

# Get reviews and extract databaseId values
# copilot-reviews returns JSON objects one per line (JSONL format)
# Use --json flag to get raw JSON output
"$COPILOT_REVIEWS" -r "$REPO" "$PR_NUMBER" --json 2>/dev/null | jq -r '.databaseId'
